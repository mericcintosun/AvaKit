# Web3Auth (MetaMask Embedded Wallets) — client ID for social login.
# Create a project at https://dashboard.web3auth.io (EVM). The client ID is a
# public value, safe to expose.
#
# On a testnet (Avalanche Fuji): create the project on Sapphire Devnet (free).
# Leave this empty to use AvaKit's bundled demo key (works on localhost only) —
# set your own before deploying to a real domain.
#
# On a mainnet (Avalanche C-Chain): create the project on Sapphire Mainnet and
# set its client ID here. There is no demo fallback on mainnet: social login
# stays disabled until this is set.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# Test AVAX for new wallets, Fuji only: empty = AvaKit's shared faucet, or your own /fund URL, or "off".
NEXT_PUBLIC_AVAKIT_FAUCET_URL=
