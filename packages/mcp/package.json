{
  "name": "@avakit/mcp",
  "version": "0.2.1",
  "mcpName": "dev.avakit/avalanche",
  "description": "AvaKit MCP server — scaffold, deploy, mint, and read Avalanche from Claude Code / Cursor.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "avakit-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "sync:server-json": "node scripts/sync-server-json.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "create-avalanche-app": "workspace:*"
  },
  "devDependencies": {
    "@avakit/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "viem": "2.58.0",
    "vitest": "catalog:",
    "zod": "4.6.7"
  },
  "keywords": [
    "avalanche",
    "avax",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "cursor",
    "web3",
    "avakit"
  ],
  "author": "AvaKit contributors",
  "homepage": "https://github.com/mericcintosun/AvaKit#readme",
  "bugs": {
    "url": "https://github.com/mericcintosun/AvaKit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mericcintosun/AvaKit.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=22"
  }
}
